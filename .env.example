# Copy to .env and adjust. .env is git-ignored and must never be committed.
# Production values are set as environment variables on the host, not in a file.

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
#
# Two roles, deliberately.
#
# DATABASE_URL is what the running application connects as: a least-privilege
# role that can read and write the working tables but can only INSERT into
# loan_events — no UPDATE, no DELETE, no TRUNCATE. That is what makes the
# append-only history a privilege rather than only a trigger.
#
# ADMIN_DATABASE_URL owns the schema and is used for migrations, seeding and the
# test harness reset. It is never used to serve a request.
#
# Both match docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://lending_app:lending_app_dev_password@localhost:5433/lending_library?schema=public"
ADMIN_DATABASE_URL="postgresql://lending:lending_dev_password@localhost:5433/lending_library?schema=public"

# The integration suite talks to its own database, which it truncates between
# tests, so it must never point at data you care about. Same two-role split.
TEST_DATABASE_URL="postgresql://lending_app:lending_app_dev_password@localhost:5433/lending_library_test?schema=public"
TEST_ADMIN_DATABASE_URL="postgresql://lending:lending_dev_password@localhost:5433/lending_library_test?schema=public"

# If a host only issues a single database role, point ADMIN_DATABASE_URL at the
# same connection string as DATABASE_URL. The application still works and the
# append-only trigger still holds, but the privilege-level guarantee is gone.

# --- Auth ---
# Signs the session cookie. Generate with: openssl rand -base64 32
# The server refuses to start in production if this is missing or left as the
# development placeholder.
SESSION_SECRET="dev-only-insecure-secret-change-me"

# --- Web (build-time, Vite) ---
# Left empty in the single-service deployment: the API is same-origin, served by
# the same process as the SPA, so relative /api paths work.
VITE_API_BASE_URL=
